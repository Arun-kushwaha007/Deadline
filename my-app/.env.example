# Frontend Environment Variables - CollabNest Client

# Backend API Base URL
VITE_BACKEND_URL=http://localhost:5000

# Optional AI / Gemini API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Firebase Web Client Configuration (for Push Notifications / FCM)
VITE_AI_FIREBASE_API_KEY=your_firebase_api_key
VITE_AI_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_AI_FIREBASE_PROJECT_ID=your_firebase_project_id
VITE_AI_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_AI_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_AI_FIREBASE_APP_ID=your_firebase_app_id
VITE_AI_FIREBASE_MEASUREMENT_ID=your_measurement_id
VITE_AI_FIREBASE_VAPID_KEY=your_firebase_vapid_key
