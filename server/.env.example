# Backend Environment Variables - CollabNest Server

# Server Port
PORT=5000

# MongoDB Connection URI
MONGO_URI=mongodb://localhost:27017/collabnest

# JWT Secret & Security
JWT_SECRET=your_super_secret_jwt_key_here

# Resend API Key for Email Notifications
RESEND_API_KEY=re_your_resend_api_key

# Google OAuth Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Redis Caching Configuration
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=your_redis_password

# Firebase Admin SDK Credentials
FIREBASE_PROJECT_ID=your_firebase_project_id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-service-account@your_project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY_HERE\n-----END PRIVATE KEY-----\n"

# Gemini AI API Key (Optional)
GEMINI_API_KEY=your_gemini_api_key_here

# Client Origin for CORS (comma-separated if multiple)
CLIENT_ORIGIN=http://localhost:5173,https://collabnest-iota.vercel.app
